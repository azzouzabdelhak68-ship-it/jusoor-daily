{
  "name": "jusoor-daily",
  "version": "1.0.0",
  "description": "Jusoor Daily — prayer-aware personal OS dashboard (Quran, gym, books, sleep, tasks) on Netlify",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "calendar",
    "notion",
    "productivity",
    "desktop",
    "windows",
    "offline"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@netlify/database": "^1.1.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.11",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.notioncalendar.desktop",
    "productName": "Notion Smart Calendar",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  }
}
